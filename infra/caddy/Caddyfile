{
	email {$ACME_EMAIL}
	admin off
}

(application_routes) {
	encode zstd gzip

	# Gli URL presigned MinIO hanno forma /<bucket>/<object>. Il percorso e
	# l'Host originali devono restare invariati perche fanno parte della firma.
	@minio path /{$MINIO_BUCKET}/*
	handle @minio {
		reverse_proxy minio:9000 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy nginx:80
	}
}

(security_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'none'"
		-Server
	}
}

{$APP_DOMAIN} {
	import application_routes
	import security_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Accesso deliberatamente non cifrato richiesto per l'IP pubblico. Il frontend
# mostra un avviso persistente; il dominio rimane l'ingresso raccomandato.
http://{$PUBLIC_IP} {
	import application_routes
	import security_headers
}
