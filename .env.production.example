# Copiare in .env.production e sostituire ogni valore REPLACE_*.
# Non committare mai .env.production.
APP_ENV_FILE=.env.production
ENVIRONMENT=production

# Ingresso pubblico
APP_DOMAIN=app.example.com
PUBLIC_IP=203.0.113.10
PUBLIC_BASE_URL=https://app.example.com
ACME_EMAIL=admin@example.com
ALLOW_INSECURE_IP_ACCESS=true
ALLOWED_HOSTS=app.example.com,203.0.113.10,localhost,127.0.0.1
CORS_ORIGIN=https://app.example.com,http://203.0.113.10
ENABLE_API_DOCS=false
VITE_API_URL=/api/v1

# PostgreSQL: mantenere password e URL coerenti.
POSTGRES_DB=lavoro_esterno
POSTGRES_USER=lavoro_esterno
POSTGRES_PASSWORD=REPLACE_RANDOM_POSTGRES_PASSWORD_32_CHARS
DATABASE_URL=postgresql+asyncpg://lavoro_esterno:REPLACE_RANDOM_POSTGRES_PASSWORD_32_CHARS@postgres:5432/lavoro_esterno
DATABASE_URL_SYNC=postgresql+psycopg2://lavoro_esterno:REPLACE_RANDOM_POSTGRES_PASSWORD_32_CHARS@postgres:5432/lavoro_esterno
REDIS_URL=redis://redis:6379/0

# MinIO interno in HTTP; il browser usa il dominio HTTPS tramite Caddy.
MINIO_ROOT_USER=lavoro_esterno_admin
MINIO_ROOT_PASSWORD=REPLACE_RANDOM_MINIO_PASSWORD_32_CHARS
MINIO_ACCESS_KEY=lavoro_esterno_admin
MINIO_SECRET_KEY=REPLACE_RANDOM_MINIO_PASSWORD_32_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://app.example.com
MINIO_BUCKET=lavoro-esterno-media
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PRESIGNED_TTL_MINUTES=15

# Generare quattro valori base64 diversi, ognuno derivato da 32 byte casuali.
PHONE_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTES_PHONE
AI_CREDENTIAL_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTES_AI
PROXY_CREDENTIAL_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTES_PROXY
INTEGRATION_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTES_INTEGRATION
PHONE_HMAC_SECRET=REPLACE_RANDOM_HMAC_SECRET_32_CHARS
JWT_SECRET_KEY=REPLACE_RANDOM_JWT_SECRET_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# Autenticazione e limiti
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Scraping, media e proxy
MEDIA_IMAGE_MAX_BYTES=15728640
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_PIXELS=40000000
MEDIA_VIDEO_MAX_SECONDS=300
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_EXPLICIT_THRESHOLD=0.65
MEDIA_SAFE_THRESHOLD=0.20
PROXY_PRIVATE_HOST_ALLOWLIST=
PROXY_MAX_ATTEMPTS=3
SCRAPE_PENDING_RETRY_MINUTES=2
SCRAPE_STALE_HOURS=6
SCRAPE_SCHEDULER_BATCH_SIZE=100

# AI locale; i provider cloud restano disabilitati finche configurati dalla UI.
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_DEFAULT_MODEL=gemma4:e2b
AI_CUSTOM_ENDPOINT_ALLOWLIST=
AI_MODEL_CATALOG_TTL_SECONDS=300
AI_MAX_OUTPUT_TOKENS=2000
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=100000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMPT_VERSION=summary-v2-it
OPENAI_TIMEOUT_SECONDS=60

# Retention ed export
AUDIT_LOG_RETENTION_DAYS=365
SCRAPE_ERROR_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
ADVERTISEMENT_RETENTION_DAYS=365
MEDIA_RETENTION_DAYS=180
TECHNICAL_LOG_RETENTION_DAYS=90
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_RECORDS=1000
EXPORT_MAX_UNCOMPRESSED_BYTES=2147483648
EXPORT_ORPHAN_GRACE_HOURS=24
BACKUP_RETENTION_DAYS=14

# Osservabilita
GF_SECURITY_ADMIN_PASSWORD=REPLACE_RANDOM_GRAFANA_PASSWORD_32_CHARS
OBSERVABILITY_COMPOSE_PROJECT=lavoro-esterno-1
